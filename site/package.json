{
  "name": "ginti-site",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/check-case-collisions.mjs && node scripts/check-mark.mjs && node --test scripts/build-data.test.mjs",
    "data": "npm run check && node scripts/build-data.mjs",
    "dev": "npm run data && vite",
    "build": "npm run data && tsc -b && vite build",
    "build:ci": "npm run check && tsc -b && vite build",
    "preview": "vite preview",
    "icons": "node scripts/icons.mjs",
    "card": "node scripts/card.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-devanagari": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "yaml": "^2.6.1"
  }
}
